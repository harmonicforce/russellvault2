# Server environment variables — PLACEHOLDERS ONLY. Never commit real secrets,
# tokens, private URLs, or a live project ref. Copy to server/.env for local use.

# Port the API/server listens on. Railway injects PORT automatically in prod.
PORT=4000

# Directory that holds the SQLite database file. In production this MUST point at
# a persistent volume (e.g. a Railway volume mount) so data survives redeploys.
# DATA_DIR=/data

# Full path to the SQLite database file. Overrides DATA_DIR when set.
# DATABASE_PATH=/data/vault.db

# Node environment. Set to "production" in deployed environments.
NODE_ENV=development

# --- Legacy SQLite quarantine (Genome Repair Work Order 2) -------------------
#
# The legacy inventory/purchases/cost-links/listings/sales/dashboard/checks/
# lookups routes are NOT a governed authority. They are quarantined: reachable
# only by an authenticated member of one explicitly configured workspace, and
# writable only with a second, explicit opt-in.
#
# LEGACY_WORKSPACE_ID names the single governed workspace whose members may
# reach the legacy surface. It is an ACCESS BOUNDARY, NOT AUTHORITY: the legacy
# SQLite dataset is global and has no workspace column, so this does not make
# legacy rows workspace-scoped or authoritative. It only decides who may see
# them. There is deliberately no "first workspace" fallback — with this unset,
# every legacy route fails closed with 503 legacy_surface_not_configured.
# LEGACY_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
#
# Legacy routes verify the caller's bearer token against this Supabase project
# and resolve workspace membership under that same caller JWT (never a service
# role). Both are required for the legacy surface to be configured at all.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
#
# Legacy WRITES are rejected in EVERY environment — production, development and
# test alike — unless this is exactly "true". This changed in Work Order 2: the
# old rule exempted non-production, so local and CI runs were writable by
# default and never exercised the production path. A write additionally requires
# the caller to hold owner or operator; a viewer is refused regardless of this
# flag. Never set this from client code or expose it to the browser.
# ALLOW_LEGACY_WRITES=
#
# Cross-origin policy. Production emits no CORS headers (the client is served
# from this same process, so requests are same-origin). Outside production an
# explicit, bounded allowlist applies, defaulting to the standard Vite dev
# origins http://localhost:5173 and http://127.0.0.1:5173. Set this only if your
# dev server runs elsewhere; an empty value means same-origin only. CORS grants
# no access on its own — an allowed origin still has to pass the legacy guard.
# DEV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: deployed commit SHA surfaced (read-only, no secret) by GET /api/version.
# Railway provides RAILWAY_GIT_COMMIT_SHA automatically; GIT_COMMIT_SHA is a
# manual override for other hosts.
# GIT_COMMIT_SHA=
