{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "browser:build": "VITE_SHADOW_AUTH=supabase VITE_SHADOW_IMPORT=repository-fixtures VITE_SUPABASE_URL=https://browsergate.supabase.co VITE_SUPABASE_ANON_KEY=browser-gate-anon-key-not-a-credential vite build --outDir dist-browser-gate",
    "browser:serve": "npm run browser:build && vite preview --outDir dist-browser-gate --port 4317 --strictPort --host 127.0.0.1",
    "browser:test": "playwright test",
    "browser:test:update": "playwright test --update-snapshots",
    "browser:test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@supabase/supabase-js": "2.109.0",
    "@tanstack/react-query": "^5.101.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "4.12.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
